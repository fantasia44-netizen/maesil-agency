# ================================================================
# maesil-agency — 부트스트랩 시크릿만 .env에 둡니다.
# 다른 모든 키(Render API, 다른 Supabase, Anthropic 등)는
# 웹 /settings 페이지에서 입력 → agent_work.secrets 에 저장됩니다.
# ================================================================

# Supabase (agent_work 스키마 호스트). 본인 프로젝트 URL/KEY로 채우세요.
MAESIL_TOTAL_SUPABASE_URL=
MAESIL_TOTAL_SERVICE_ROLE_KEY=

# JWT 서명 키 — 32자 이상 강력한 랜덤. 예: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# 관리자 디버그 엔드포인트 게이트 — 16자 이상. 'change-me' 등 기본값 거부됨.
API_BEARER_TOKEN=

# 매요 CS 머신간 인증 토큰 — 운영에서 반드시 설정. 미설정시 503 반환.
MAEYO_INTERNAL_TOKEN=

# CORS (와일드카드 '*' 허용 안 됨). 콤마 구분.
CORS_ORIGINS=http://localhost:3000

# (옵션) 명시적 dev override — CS 토큰 없이 무인증 허용. 운영에서 절대 1로 두지 말 것.
# CS_ALLOW_UNAUTH=0

# ================================================================
# 보안 토글 (운영 기본값=안전. 불편하면 아래 값으로 완화 가능)
# ================================================================

# 시크릿 봉투암호화 키(Fernet). 미설정 시 평문 저장(기존 호환).
# 생성: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ※ 설정 후 /settings에서 각 시크릿을 한 번 재저장하면 암호화로 마이그레이션됩니다.
# SECRETS_ENC_KEY=

# 관리자 디버그 엔드포인트(/admin/*). 기본 비활성(접근 시 404).
# 진단이 필요할 때만 1로 켜고, 토큰은 X-Admin-Token 헤더로 전달(쿼리스트링 금지).
# ENABLE_DEBUG_ENDPOINTS=0

# 매 요청 사용자 상태 재검증(비활성화/강등 즉시 반영). 기본 1.
# 부하가 부담되면 0으로 끄고 토큰 만료(7일)에만 의존.
# AUTH_REVALIDATE=1
# AUTH_REVALIDATE_CACHE_TTL=30

# 로그인 무차별 대입 방어. 0이면 비활성.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15

# Growth 대화 조회를 super_admin 전용으로 제한. 기본 1.
# GROWTH_ADMIN_ONLY=1

# Gmail 이메일 회신 분석(스케줄러). 영업이 카톡 오픈챗으로 전환되어 기본 off(0).
# 이메일 회신 추적이 다시 필요하면 1.
# ENABLE_GMAIL_WATCHER=0

# (옵션) Growth M2M 무인증 허용 — 운영에서 절대 1로 두지 말 것.
# GROWTH_ALLOW_UNAUTH=0
