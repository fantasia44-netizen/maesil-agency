# ================================================================
# maesil-agency — 부트스트랩 시크릿만 .env에 둡니다.
# 다른 모든 키(Render API, 다른 Supabase, Anthropic 등)는
# 웹 /settings 페이지에서 입력 → agent_work.secrets 에 저장됩니다.
# ================================================================

# Supabase (agent_work 스키마 호스트). 본인 프로젝트 URL/KEY로 채우세요.
MAESIL_TOTAL_SUPABASE_URL=
MAESIL_TOTAL_SERVICE_ROLE_KEY=

# JWT 서명 키 — 32자 이상 강력한 랜덤. 예: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# 관리자 디버그 엔드포인트 게이트 — 16자 이상. 'change-me' 등 기본값 거부됨.
API_BEARER_TOKEN=

# 매요 CS 머신간 인증 토큰 — 운영에서 반드시 설정. 미설정시 503 반환.
MAEYO_INTERNAL_TOKEN=

# CORS (와일드카드 '*' 허용 안 됨). 콤마 구분.
CORS_ORIGINS=http://localhost:3000

# (옵션) 명시적 dev override — CS 토큰 없이 무인증 허용. 운영에서 절대 1로 두지 말 것.
# CS_ALLOW_UNAUTH=0

# ================================================================
# 보안 토글 (운영 기본값=안전. 불편하면 아래 값으로 완화 가능)
# ================================================================

# 시크릿 봉투암호화 키(Fernet). 미설정 시 평문 저장(기존 호환).
# 생성: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ※ 설정 후 /settings에서 각 시크릿을 한 번 재저장하면 암호화로 마이그레이션됩니다.
# SECRETS_ENC_KEY=

# 관리자 디버그 엔드포인트(/admin/*). 기본 비활성(접근 시 404).
# 진단이 필요할 때만 1로 켜고, 토큰은 X-Admin-Token 헤더로 전달(쿼리스트링 금지).
# ENABLE_DEBUG_ENDPOINTS=0

# 매 요청 사용자 상태 재검증(비활성화/강등 즉시 반영). 기본 1.
# 부하가 부담되면 0으로 끄고 토큰 만료(7일)에만 의존.
# AUTH_REVALIDATE=1
# AUTH_REVALIDATE_CACHE_TTL=30

# 로그인 무차별 대입 방어. 0이면 비활성.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15

# Growth 대화 조회를 super_admin 전용으로 제한. 기본 1.
# GROWTH_ADMIN_ONLY=1

# Gmail 이메일 회신 분석(스케줄러). 영업이 카톡 오픈챗으로 전환되어 기본 off(0).
# 이메일 회신 추적이 다시 필요하면 1.
# ENABLE_GMAIL_WATCHER=0

# ── 영업 이메일 컴플라이언스 / 카피 ───────────────────────────────────
# 수신거부 링크 베이스(에이전시 백엔드 공개 URL). 비우면 "수신거부 회신" 안내만.
# UNSUBSCRIBE_BASE_URL=https://maesil-agency.onrender.com
# 광고 메일 하단 전송자 정보(상호·사업자번호·주소·연락처) — 법적 표기.
# OUTREACH_SENDER_INFO=매실인사이트 · 사업자 000-00-00000 · 서울 ... · support@maesil-insight.com
# 제목 맨 앞 "(광고)" 자동 표기(기본 1). 끄면 법적 리스크 — 권장 안 함.
# OUTREACH_AD_PREFIX=1
# 야간(21~08 KST) 자동 팔로업 보류(기본 1).
# OUTREACH_QUIET_HOURS=1
# 제목 카피는 운영자가 직접 통제. {handle}=채널명, {company}=회사명. (광고)는 자동 부착.
# OUTREACH_INFLUENCER_SUBJECT=광고비·ROAS 콘텐츠 소재가 부족하신가요?
# OUTREACH_AGENCY_SUBJECT=무료체험 — {company}님 네이버·쿠팡 광고 리포트 10분 자동화
# 희소성: N>0 이면 "현재 셀러 유튜버 N팀만 모집" 노출(거짓이면 안 됨). 0=숨김.
# OUTREACH_BETA_SLOTS=0
# 메일 내 링크
# OUTREACH_MAEPAS_URL=https://maesil-insight.com/partners
# OUTREACH_CASES_URL=https://maesil-insight.com/cases

# ── 콜드 드립 발송 (유튜버 콜드 — 별도 Workspace 메일박스 Gmail API) ──
# 트랜잭션(Resend)과 완전 분리. 세팅 끝나면 1로 켜기.
# ENABLE 전 필수: ① maesil-partners.com Workspace 메일박스 ② 아래 gmail 시크릿(/settings)
#                ③ UNSUBSCRIBE_BASE_URL(수신거부·클릭추적 링크 베이스)
# OUTREACH_COLD_DRIP_ENABLED=0
# OUTREACH_DAILY_CAP=30
# OUTREACH_DRIP_GRADES=S,A
# OUTREACH_SEND_START_HOUR=10
# OUTREACH_SEND_END_HOUR=17
# OUTREACH_KAKAO_URL=https://open.kakao.com/o/xxxxxx
# gmail 발송 시크릿은 /settings(secrets)에 저장:
#   outreach_gmail_client_id / outreach_gmail_client_secret /
#   outreach_gmail_refresh_token(scope: gmail.send) / outreach_gmail_from

# (옵션) Growth M2M 무인증 허용 — 운영에서 절대 1로 두지 말 것.
# GROWTH_ALLOW_UNAUTH=0
